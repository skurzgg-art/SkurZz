<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Streamer Chaos Arena PRO</title>
</head>

<body style="margin:0;overflow:hidden;">
<canvas id="c"></canvas>

<script>

const c = document.getElementById("c");
const ctx = c.getContext("2d");

c.width = window.innerWidth;
c.height = window.innerHeight;

// =====================
// 🌍 ARENA
// =====================
const cx = c.width/2;
const cy = c.height/2;
const arenaRadius = Math.min(c.width,c.height)*0.25;

// =====================
// GAME STATE
// =====================
let balls=[];
let gameOver=false;
let finalTop=[];
let restartTimer=0;

// =====================
// SOUND
// =====================
let soundEnabled=false;
window.addEventListener("click",()=>soundEnabled=true);

function playSound(f,t){
  if(!soundEnabled) return;
  let a=new (window.AudioContext||webkitAudioContext)();
  let o=a.createOscillator();
  let g=a.createGain();
  o.connect(g); g.connect(a.destination);
  o.frequency.value=f;
  o.type="sine";
  o.start();
  o.stop(a.currentTime+t);
  g.gain.setValueAtTime(0.2,a.currentTime);
  g.gain.exponentialRampToValueAtTime(0.001,a.currentTime+t);
}
let viewers = {};

// =====================
// 🧑 CREATE BOULE VIEWER
// =====================
function createViewerBall(name){

  let ball = {
    x: cx + (Math.random()-0.5)*arenaRadius,
    y: cy + (Math.random()-0.5)*arenaRadius,
    dx: (Math.random()-0.5)*3,
    dy: (Math.random()-0.5)*3,
    r: 22,
    name: name,
    emoji: getEmoji(name),
    points: 50,
    fx:[]
  };

  balls.push(ball);
  viewers[name] = ball;

  return ball;
}

// =====================
// 👆 TAP = +1 POINT
// =====================
function tap(viewerName){

  // création au 1er tap
  if(!viewers[viewerName]){
    createViewerBall(viewerName);
  }

  let ball = viewers[viewerName];

  if(ball){

    ball.points = Math.min(500, ball.points + 1);

    ball.fx.push({
      t:"+1",
      life:25
    });
  }
}

// =====================
// 🌹 ROSE = +20 POINTS
// =====================
function rose(viewerName){

  // création si pas encore existant
  if(!viewers[viewerName]){
    createViewerBall(viewerName);
  }

  let ball = viewers[viewerName];

  if(ball){

    ball.points = Math.min(500, ball.points + 20);

    ball.fx.push({
      t:"+20 🌹",
      life:40
    });

    playSound(800,0.12);
  }
}

// =====================
// PARTICLES
// =====================
let particles=[];
for(let i=0;i<80;i++){
  particles.push({
    x:Math.random()*c.width,
    y:Math.random()*c.height,
    r:Math.random()*2,
    dx:(Math.random()-0.5)*0.3,
    dy:(Math.random()-0.5)*0.3
  });
}

// =====================
// PLAYERS
// =====================
const emojis=["😀","😎","🤖","👻","🐱","🐶","🐸","🦊","🔥","⚡","💀","👑","💎"];

function getEmoji(n){
  let h=0;
  for(let i=0;i<n.length;i++)h+=n.charCodeAt(i);
  return emojis[Math.abs(h)%emojis.length];
}

function getColor(p){
  if(p>=450) return "#ffd700";
  if(p>=300) return "#00ff88";
  if(p>=200) return "#00bfff";
  if(p>=100) return "#ff8800";
  return "#ff4444";
}

function createBall(){
  let name="User"+Math.floor(Math.random()*999);
  return{
    x:cx+(Math.random()-0.5)*arenaRadius,
    y:cy+(Math.random()-0.5)*arenaRadius,
    dx:(Math.random()-0.5)*4,
    dy:(Math.random()-0.5)*4,
    r:24,
    name,
    emoji:getEmoji(name),
    points:50
  };
}

setInterval(()=>{
  if(!gameOver && balls.length<40) balls.push(createBall());
},800);

// =====================
// COLLISION
// =====================
function collide(a,b){
  let dx=a.x-b.x;
  let dy=a.y-b.y;
  return Math.sqrt(dx*dx+dy*dy)<a.r+b.r;
}

 function fight(a,b){

  // sécurité
  if(!a || !b) return;

  // =====================
  // SCORE SYSTEM FIXÉ
  // =====================
  if(a.points > b.points){
    a.points = Math.min(500, a.points + 1);
    b.points = Math.max(0, b.points - 1);
  } else if(b.points > a.points){
    b.points = Math.min(500, b.points + 1);
    a.points = Math.max(0, a.points - 1);
  } else {
    // égalité → petit bonus aléatoire
    if(Math.random() > 0.5){
      a.points = Math.min(500, a.points + 1);
    } else {
      b.points = Math.min(500, b.points + 1);
    }
  }

  // =====================
  // REBOND PHYSIQUE PROPRE
  // =====================
  let dx = b.x - a.x;
  let dy = b.y - a.y;

  let dist = Math.sqrt(dx*dx + dy*dy) || 1;

  let nx = dx / dist;
  let ny = dy / dist;

  let overlap = (a.r + b.r) - dist;

  if(overlap > 0){
    a.x -= nx * overlap * 0.5;
    a.y -= ny * overlap * 0.5;

    b.x += nx * overlap * 0.5;
    b.y += ny * overlap * 0.5;
  }

  // échange vitesse (rebond arcade)
  let vx = a.dx;
  let vy = a.dy;

  a.dx = b.dx;
  a.dy = b.dy;

  b.dx = vx;
  b.dy = vy;
}

// =====================
// RESET GAME
// =====================
function resetGame(){
  balls=[];
  gameOver=false;
  finalTop=[];
  restartTimer=0;
}

// =====================
// LOOP
// =====================
function loop(){

  // =====================
  // GAME OVER SCREEN
  // =====================
  if(gameOver){

    ctx.fillStyle="rgba(0,0,0,0.7)";
    ctx.fillRect(0,0,c.width,c.height);

    ctx.textAlign="center";

    ctx.fillStyle="white";
    ctx.font="bold 40px Arial";
    ctx.fillText("🏁 FIN DE PARTIE",c.width/2,150);

    ctx.font="20px Arial";
    ctx.fillText("PODIUM",c.width/2,200);

    let y=280;

    let medals=["🥇","🥈","🥉"];

    for(let i=0;i<finalTop.length;i++){

      let p=finalTop[i];

      let scale=1 + Math.sin(Date.now()/200 + i)*0.1;

      ctx.save();
      ctx.translate(c.width/2,y+i*90);
      ctx.scale(scale,scale);

      ctx.font="bold 30px Arial";
      ctx.fillText(medals[i]+" "+p.name+" - "+p.points,0,0);

      ctx.restore();
    }

    restartTimer++;

    if(restartTimer>300){
      resetGame();
    }

    requestAnimationFrame(loop);
    return;
  }

  // =====================
  // BACKGROUND
  // =====================
  let grd=ctx.createRadialGradient(cx,cy,100,cx,cy,c.width);
  grd.addColorStop(0,"#0f172a");
  grd.addColorStop(1,"#000");
  ctx.fillStyle=grd;
  ctx.fillRect(0,0,c.width,c.height);

  // arena circle
  ctx.beginPath();
  ctx.arc(cx,cy,arenaRadius,0,Math.PI*2);
  ctx.strokeStyle="rgba(255,255,255,0.2)";
  ctx.stroke();

  // particles
  ctx.fillStyle="rgba(255,255,255,0.3)";
  for(let p of particles){
    ctx.beginPath();
    ctx.arc(p.x,p.y,p.r,0,Math.PI*2);
    ctx.fill();
  }

  // =====================
  // BALLS
  // =====================
  for(let i=0;i<balls.length;i++){
    let b=balls[i];

    b.x+=b.dx;
    b.y+=b.dy;

    let dx=b.x-cx;
    let dy=b.y-cy;
    let dist=Math.sqrt(dx*dx+dy*dy);

    if(dist>arenaRadius-b.r){
      let nx=dx/dist;
      let ny=dy/dist;

      b.x=cx+nx*(arenaRadius-b.r);
      b.y=cy+ny*(arenaRadius-b.r);

      b.dx*=-1;
      b.dy*=-1;
    }

    for(let j=i+1;j<balls.length;j++){
      if(collide(b,balls[j])) fight(b,balls[j]);
    }

    if(b.points>=500){
      gameOver=true;
      finalTop=[...balls].sort((a,b)=>b.points-a.points).slice(0,3);
    }

    let col=getColor(b.points);

    ctx.shadowBlur=15;
    ctx.shadowColor=col;

    ctx.beginPath();
    ctx.fillStyle=col;
    ctx.arc(b.x,b.y,b.r,0,Math.PI*2);
    ctx.fill();

  // =====================
  // 🎯 SCORE DANS LA BOULE
  // =====================

      // =====================
  // 😀 EMOJI (EN ARRIÈRE)
  // =====================
  ctx.textAlign = "center";
  ctx.font = "20px Arial";
  ctx.fillText(b.emoji, b.x, b.y + 5);

  // =====================
  // 🏆 SCORE (DEVANT L’EMOJI)
  // =====================
  ctx.fillStyle = "white";
  ctx.strokeStyle = "black";
  ctx.lineWidth = 3;
  ctx.font = "bold 14px Arial";

  ctx.strokeText(b.points, b.x, b.y - 10);
  ctx.fillText(b.points, b.x, b.y - 10);

    ctx.fillStyle="white";
    ctx.font="12px Arial";
    ctx.fillText(b.name,b.x,b.y-b.r-8);
  }

       // =====================
  // 🏆 ULTRA VIRAL LEADERBOARD (TOP CENTER)
  // =====================
  let top = [...balls]
    .sort((a,b)=>b.points-a.points)
    .slice(0,5);

  // 📍 position au-dessus de l’arène
  let w = 320;
  let h = 210;

  let x = c.width/2 - w/2;
  let y = cy - arenaRadius - 230; // 👈 AU DESSUS DE L'ARENE

  // =====================
  // 🎨 BACKGROUND GLASS
  // =====================
  let grad = ctx.createLinearGradient(x, y, x + w, y + h);
  grad.addColorStop(0, "rgba(0,0,0,0.70)");
  grad.addColorStop(1, "rgba(10,20,40,0.40)");

  ctx.fillStyle = grad;
  ctx.fillRect(x, y, w, h);

  // 🔵 BORDER GLOW
  ctx.strokeStyle = "rgba(0,255,255,0.35)";
  ctx.lineWidth = 2;
  ctx.strokeRect(x, y, w, h);

  // =====================
  // 🏆 TITLE
  // =====================
  ctx.textAlign = "center";
  ctx.fillStyle = "#00ffff";
  ctx.font = "bold 20px Arial";
  ctx.shadowBlur = 15;
  ctx.shadowColor = "#00ffff";
  ctx.fillText("🏆 TOP PLAYERS", x + w/2, y + 30);
  ctx.shadowBlur = 0;

  // =====================
  // PLAYERS LIST
  // =====================
  for(let i=0;i<top.length;i++){

    let p = top[i];
    let barY = y + 60 + i * 28;

    let percent = p.points / 500;

    // 🎨 rank colors
    let color =
      i === 0 ? "#ffd700" :
      i === 1 ? "#c0c0c0" :
      i === 2 ? "#cd7f32" :
      "#00bfff";

    // background bar
    ctx.fillStyle = "rgba(255,255,255,0.08)";
    ctx.fillRect(x + 15, barY, w - 30, 16);

    // progress bar
    ctx.fillStyle = color;
    ctx.fillRect(x + 15, barY, (w - 30) * percent, 16);

    // 🔥 glow #1 player
    if(i === 0){
      ctx.shadowBlur = 20;
      ctx.shadowColor = "#ffd700";
      ctx.fillRect(x + 15, barY, (w - 30) * percent, 16);
      ctx.shadowBlur = 0;
    }

    // text
    ctx.fillStyle = "white";
    ctx.font = "13px Arial";
    ctx.textAlign = "left";
    ctx.fillText(
      `${i+1}. ${p.name}`,
      x + 18,
      barY + 12
    );

    ctx.textAlign = "right";
    ctx.fillText(
      `${p.points}`,
      x + w - 20,
      barY + 12
    );

    // 👑 crown on #1
    if(i === 0){
      ctx.textAlign = "center";
      ctx.fillText("👑", x + w/2, barY + 12);
    }
  }

  requestAnimationFrame(loop);
}

loop();

// =====================
// 🔗 CONNECT TIKFINITY
// =====================
window.tap = tap;
window.rose = rose;

</script>
</body>
</html>
